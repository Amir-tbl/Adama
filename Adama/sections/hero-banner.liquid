{%- style -%}
  .hero-banner--{{ section.id }} {
    min-height: {{ section.settings.height }}vh;
    color: {{ section.settings.text_color }};
  }
  .hero-banner--{{ section.id }} .hero-banner__overlay {
    background-color: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
  }
{%- endstyle -%}

<div class="hero-banner hero-banner--{{ section.id }}{% if section.settings.full_width %} hero-banner--full{% endif %}" data-animate="fade-in">
  <div class="hero-banner__media">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1920 }}"
        srcset="
          {{ section.settings.image | image_url: width: 750 }} 750w,
          {{ section.settings.image | image_url: width: 1100 }} 1100w,
          {{ section.settings.image | image_url: width: 1500 }} 1500w,
          {{ section.settings.image | image_url: width: 1920 }} 1920w
        "
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
        fetchpriority="high"
        class="hero-banner__image"
      >
    {%- else -%}
      <div class="hero-banner__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
    {%- if section.settings.mobile_image != blank -%}
      <img
        src="{{ section.settings.mobile_image | image_url: width: 750 }}"
        srcset="
          {{ section.settings.mobile_image | image_url: width: 375 }} 375w,
          {{ section.settings.mobile_image | image_url: width: 750 }} 750w
        "
        sizes="100vw"
        alt="{{ section.settings.mobile_image.alt | default: section.settings.heading }}"
        width="{{ section.settings.mobile_image.width }}"
        height="{{ section.settings.mobile_image.height }}"
        loading="eager"
        fetchpriority="high"
        class="hero-banner__image hero-banner__image--mobile"
      >
    {%- endif -%}
  </div>

  <div class="hero-banner__overlay"></div>

  <div class="hero-banner__content container" style="text-align: {{ section.settings.text_alignment }};">
    {%- if section.settings.subheading_top != blank -%}
      <p class="hero-banner__subheading-top" data-animate="fade-up" data-delay="100">{{ section.settings.subheading_top }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero-banner__heading" data-animate="fade-up" data-delay="200">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hero-banner__subheading" data-animate="fade-up" data-delay="300">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="btn btn--primary hero-banner__button"
        data-animate="fade-up"
        data-delay="400"
      >
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)"
    },
    {
      "type": "range",
      "id": "height",
      "min": 40,
      "max": 100,
      "step": 5,
      "default": 80,
      "unit": "vh",
      "label": "Section height"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "Full width"
    },
    {
      "type": "text",
      "id": "subheading_top",
      "label": "Top subheading",
      "default": "New Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Timeless Elegance, Modern Spirit",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "default": "Discover our new collection blending classic craftsmanship with contemporary design",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Shop Now",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "label": "Text alignment"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#ffffff",
      "label": "Text color"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30,
      "unit": "%",
      "label": "Overlay opacity"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
