<div class="product-page section-spacing">
  <div class="container">
    <div class="product-page__grid">
      {%- comment -%} Product Gallery {%- endcomment -%}
      <div class="product-gallery" data-product-gallery>
        <div class="product-gallery__main" data-product-gallery-main>
          {%- for media in product.media -%}
            <div
              class="product-gallery__slide{% if forloop.first %} is-active{% endif %}"
              data-gallery-slide="{{ forloop.index0 }}"
              data-media-id="{{ media.id }}"
            >
              {%- if media.media_type == 'image' -%}
                <div class="product-gallery__image-wrapper" data-image-zoom>
                  <img
                    src="{{ media | image_url: width: 800 }}"
                    srcset="
                      {{ media | image_url: width: 400 }} 400w,
                      {{ media | image_url: width: 600 }} 600w,
                      {{ media | image_url: width: 800 }} 800w,
                      {{ media | image_url: width: 1200 }} 1200w
                    "
                    sizes="(min-width: 1024px) 50vw, 100vw"
                    alt="{{ media.alt | escape | default: product.title }}"
                    width="{{ media.width }}"
                    height="{{ media.height }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    class="product-gallery__image"
                    data-zoom-src="{{ media | image_url: width: 1800 }}"
                  >
                </div>
              {%- elsif media.media_type == 'video' -%}
                {{ media | video_tag: autoplay: false, controls: true, class: 'product-gallery__video' }}
              {%- elsif media.media_type == 'external_video' -%}
                {{ media | external_video_tag: class: 'product-gallery__video' }}
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="product-gallery__slide is-active">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endfor -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product-gallery__thumbs" data-product-thumbs>
            {%- for media in product.media -%}
              <button
                class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-gallery-thumb="{{ forloop.index0 }}"
                aria-label="{{ 'products.product.media_number' | t: number: forloop.index }}"
              >
                <img
                  src="{{ media | image_url: width: 100 }}"
                  alt="{{ media.alt | escape | default: product.title }}"
                  width="80"
                  height="80"
                  loading="lazy"
                  class="product-gallery__thumb-image"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Product Info {%- endcomment -%}
      <div class="product-info" data-product-info>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'title' -%}
              <div class="product-info__block" {{ block.shopify_attributes }}>
                {%- if section.settings.show_vendor and product.vendor != blank -%}
                  <p class="product-info__vendor">{{ product.vendor }}</p>
                {%- endif -%}
                <h1 class="product-info__title">{{ product.title }}</h1>
              </div>

            {%- when 'price' -%}
              <div class="product-info__block" {{ block.shopify_attributes }}>
                <div class="product-info__price" data-product-price>
                  {%- if product.compare_at_price > product.price -%}
                    <span class="product-info__price--sale">{{ product.price | money }}</span>
                    <span class="product-info__price--compare">{{ product.compare_at_price | money }}</span>
                    <span class="product-info__badge product-info__badge--sale">
                      {{ 'products.product.on_sale' | t }}
                    </span>
                  {%- else -%}
                    <span class="product-info__price--regular">{{ product.price | money }}</span>
                  {%- endif -%}
                </div>
              </div>

            {%- when 'variant_picker' -%}
              <div class="product-info__block" {{ block.shopify_attributes }}>
                {%- unless product.has_only_default_variant -%}
                  {%- for option in product.options_with_values -%}
                    <div class="product-option" data-option-index="{{ forloop.index0 }}">
                      <label class="product-option__label">
                        {{ option.name }}
                        {%- if option.name == 'Size' -%}
                          <button type="button" class="product-option__size-guide" data-size-guide-toggle>
                            {{ 'products.product.size_guide' | t }}
                          </button>
                        {%- endif -%}
                      </label>
                      <div class="product-option__values">
                        {%- for value in option.values -%}
                          <label class="product-option__value{% if option.selected_value == value %} is-selected{% endif %}{% if option.name == 'Color' %} product-option__value--color{% endif %}">
                            <input
                              type="radio"
                              name="option-{{ option.name | handleize }}"
                              value="{{ value | escape }}"
                              {% if option.selected_value == value %}checked{% endif %}
                              data-option-input
                              class="visually-hidden"
                            >
                            {%- if option.name == 'Color' -%}
                              <span class="product-option__swatch" style="background-color: {{ value | handleize }};"></span>
                              <span class="visually-hidden">{{ value }}</span>
                            {%- else -%}
                              <span class="product-option__button">{{ value }}</span>
                            {%- endif -%}
                          </label>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endfor -%}
                {%- endunless -%}

                <select name="id" data-product-select class="visually-hidden">
                  {%- for variant in product.variants -%}
                    <option
                      value="{{ variant.id }}"
                      {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                      data-variant-json='{{ variant | json }}'
                    >
                      {{ variant.title }} - {{ variant.price | money }}
                    </option>
                  {%- endfor -%}
                </select>
              </div>

            {%- when 'quantity_selector' -%}
              <div class="product-info__block" {{ block.shopify_attributes }}>
                <label class="product-option__label" for="product-quantity">{{ 'products.product.quantity' | t }}</label>
                <div class="quantity-selector" data-quantity-selector>
                  <button
                    type="button"
                    class="quantity-selector__btn"
                    data-quantity-minus
                    aria-label="{{ 'products.product.decrease_quantity' | t }}"
                  >
                    <svg width="12" height="2" viewBox="0 0 12 2" fill="none" aria-hidden="true">
                      <path d="M1 1h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </button>
                  <input
                    type="number"
                    id="product-quantity"
                    class="quantity-selector__input"
                    value="1"
                    min="1"
                    max="{{ product.selected_or_first_available_variant.inventory_quantity | default: 99 }}"
                    data-quantity-input
                    aria-label="{{ 'products.product.quantity' | t }}"
                  >
                  <button
                    type="button"
                    class="quantity-selector__btn"
                    data-quantity-plus
                    aria-label="{{ 'products.product.increase_quantity' | t }}"
                  >
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                      <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </button>
                </div>
              </div>

            {%- when 'buy_buttons' -%}
              <div class="product-info__block" {{ block.shopify_attributes }}>
                <div class="product-actions">
                  <button
                    type="button"
                    class="btn btn--primary btn--full product-actions__add-to-cart"
                    data-add-to-cart
                    {% unless product.available %}disabled{% endunless %}
                  >
                    <span data-add-to-cart-text>
                      {%- if product.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                    <span class="product-actions__spinner" data-spinner aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                      </svg>
                    </span>
                  </button>

                  <button
                    type="button"
                    class="btn btn--icon product-actions__wishlist"
                    data-wishlist-add="{{ product.id }}"
                    aria-label="{{ 'products.product.add_to_wishlist' | t }}"
                  >
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                    </svg>
                  </button>
                </div>

                {%- if block.settings.show_dynamic_checkout -%}
                  <div class="product-actions__dynamic">
                    {{ form | payment_button }}
                  </div>
                {%- endif -%}
              </div>

            {%- when 'collapsible_tab' -%}
              <div class="product-info__block" {{ block.shopify_attributes }}>
                <details class="accordion">
                  <summary class="accordion__header">
                    <span class="accordion__title">{{ block.settings.heading }}</span>
                    <svg class="accordion__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M6 9l6 6 6-6"/>
                    </svg>
                  </summary>
                  <div class="accordion__content rte">
                    {%- if block.settings.content_source == 'description' -%}
                      {{ product.description }}
                    {%- else -%}
                      {{ block.settings.content }}
                    {%- endif -%}
                  </div>
                </details>
              </div>

            {%- when 'size_guide' -%}
              <div class="product-info__block" {{ block.shopify_attributes }}>
                {%- comment -%} Size guide modal triggered from variant picker {%- endcomment -%}
                <div class="modal" data-size-guide-modal aria-hidden="true" role="dialog" aria-label="{{ block.settings.heading }}">
                  <div class="modal__overlay" data-modal-close></div>
                  <div class="modal__content">
                    <div class="modal__header">
                      <h3 class="modal__title">{{ block.settings.heading }}</h3>
                      <button class="modal__close" data-modal-close aria-label="{{ 'accessibility.close' | t }}">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M18 6L6 18M6 6l12 12"/>
                        </svg>
                      </button>
                    </div>
                    <div class="modal__body rte">
                      <table class="size-guide-table">
                        <thead>
                          <tr>
                            <th>Size</th><th>Chest (cm)</th><th>Waist (cm)</th><th>Hips (cm)</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr><td>XS</td><td>82-86</td><td>63-67</td><td>88-92</td></tr>
                          <tr><td>S</td><td>86-90</td><td>67-71</td><td>92-96</td></tr>
                          <tr><td>M</td><td>90-94</td><td>71-75</td><td>96-100</td></tr>
                          <tr><td>L</td><td>94-98</td><td>75-79</td><td>100-104</td></tr>
                          <tr><td>XL</td><td>98-102</td><td>79-83</td><td>104-108</td></tr>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} Quick View Modal {%- endcomment -%}
  <div class="modal" data-quick-view-modal aria-hidden="true" role="dialog">
    <div class="modal__overlay" data-modal-close></div>
    <div class="modal__content modal__content--large">
      <button class="modal__close" data-modal-close aria-label="{{ 'accessibility.close' | t }}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
      <div class="quick-view__content" data-quick-view-content></div>
    </div>
  </div>
</div>

<script type="application/json" data-product-json>
  {{ product | json }}
</script>

{% schema %}
{
  "name": "Product Page",
  "tag": "section",
  "class": "section-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": true,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "default": false,
      "label": "Show SKU"
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "default": true,
      "label": "Enable image zoom"
    },
    {
      "type": "checkbox",
      "id": "show_share_buttons",
      "default": true,
      "label": "Show share buttons"
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "options": [
            { "value": "button", "label": "Buttons" },
            { "value": "dropdown", "label": "Dropdown" }
          ],
          "default": "button",
          "label": "Picker type"
        }
      ]
    },
    {
      "type": "quantity_selector",
      "name": "Quantity Selector",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "default": true,
          "label": "Show dynamic checkout button"
        }
      ]
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible Tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Tab Heading",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "content_source",
          "options": [
            { "value": "description", "label": "Product description" },
            { "value": "custom", "label": "Custom content" }
          ],
          "default": "custom",
          "label": "Content source"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Custom content"
        }
      ]
    },
    {
      "type": "size_guide",
      "name": "Size Guide",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Size Guide",
          "label": "Heading"
        }
      ]
    }
  ]
}
{% endschema %}
