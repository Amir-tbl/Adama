<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }}</title>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <div class="password-page">
    <header class="password-header">
      <h1 class="password-logo">{{ shop.name }}</h1>
    </header>

    <main class="password-main" role="main">
      <div class="password-content">
        <h2>{{ 'general.password_page.opening_soon' | t }}</h2>
        {% if shop.password_message != blank %}
          <p class="password-message">{{ shop.password_message }}</p>
        {% endif %}

        {{ content_for_layout }}

        <div class="password-form-wrapper">
          {% form 'storefront_password' %}
            <div class="password-form">
              <input
                type="password"
                name="password"
                placeholder="{{ 'general.password_page.password_placeholder' | t }}"
                class="input-field"
                aria-label="{{ 'general.password_page.password_placeholder' | t }}"
              >
              <button type="submit" class="btn btn--primary">
                {{ 'general.password_page.enter' | t }}
              </button>
            </div>
            {% if form.errors %}
              <p class="form-error">{{ form.errors | default_errors }}</p>
            {% endif %}
          {% endform %}
        </div>
      </div>
    </main>

    <footer class="password-footer">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ powered_by_link }}</p>
    </footer>
  </div>
</body>
</html>
