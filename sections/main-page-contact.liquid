<div class="contact-page section-spacing">
  <div class="container container--narrow">
    <div class="contact-page__header" data-animate="fade-up">
      <h1 class="contact-page__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="contact-page__subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="contact-page__grid" data-animate="fade-up" data-delay="200">
      <div class="contact-page__form-wrapper">
        {% form 'contact', class: 'contact-form' %}
          {%- if form.posted_successfully? -%}
            <div class="form-success">
              <p>{{ 'contact.form.post_success' | t }}</p>
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="form-errors">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="contact-form__row">
            <div class="contact-form__field">
              <label for="contact-name" class="contact-form__label">{{ 'contact.form.name' | t }} *</label>
              <input
                type="text"
                id="contact-name"
                name="contact[{{ 'contact.form.name' | t }}]"
                class="input-field"
                required
                autocomplete="name"
              >
            </div>
            <div class="contact-form__field">
              <label for="contact-email" class="contact-form__label">{{ 'contact.form.email' | t }} *</label>
              <input
                type="email"
                id="contact-email"
                name="contact[email]"
                class="input-field"
                required
                autocomplete="email"
              >
            </div>
          </div>

          <div class="contact-form__field">
            <label for="contact-phone" class="contact-form__label">{{ 'contact.form.phone' | t }}</label>
            <input
              type="tel"
              id="contact-phone"
              name="contact[{{ 'contact.form.phone' | t }}]"
              class="input-field"
              autocomplete="tel"
            >
          </div>

          <div class="contact-form__field">
            <label for="contact-subject" class="contact-form__label">{{ 'contact.form.subject' | t }}</label>
            <select id="contact-subject" name="contact[{{ 'contact.form.subject' | t }}]" class="select-field">
              <option value="">{{ 'contact.form.select_subject' | t }}</option>
              <option value="General Inquiry">{{ 'contact.form.general_inquiry' | t }}</option>
              <option value="Order Support">{{ 'contact.form.order_support' | t }}</option>
              <option value="Returns & Exchanges">{{ 'contact.form.returns' | t }}</option>
              <option value="Wholesale">{{ 'contact.form.wholesale' | t }}</option>
            </select>
          </div>

          <div class="contact-form__field">
            <label for="contact-message" class="contact-form__label">{{ 'contact.form.message' | t }} *</label>
            <textarea
              id="contact-message"
              name="contact[body]"
              class="input-field contact-form__textarea"
              rows="6"
              required
            ></textarea>
          </div>

          <button type="submit" class="btn btn--primary">
            {{ 'contact.form.send' | t }}
          </button>
        {% endform %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact Page",
  "tag": "section",
  "class": "section-contact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Get in Touch",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "default": "We'd love to hear from you. Send us a message and we'll respond as soon as possible.",
      "label": "Subheading"
    }
  ]
}
{% endschema %}
